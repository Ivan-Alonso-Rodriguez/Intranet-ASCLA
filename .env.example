# Configuración local / del servidor. Jenkins utiliza un Secret file por entorno.
# Nunca versionar un .env real con secretos.

ASCLA_DB_HOST=db
ASCLA_DB_NAME=wordpress
ASCLA_DB_USER=wordpress
ASCLA_DB_PASSWORD=
ASCLA_DB_ROOT_PASSWORD=

ASCLA_ADMIN_PASSWORD=
ASCLA_DEMO_PASSWORD=

# Opcional: perfil adicional de demostracion (12+ caracteres).
ASCLA_PROFILE_DEMO_PASSWORD=

# Deben ser distintos por entorno si dev/qa/uat viven en el mismo host.
ASCLA_HTTP_PORT=8088
ASCLA_MAILPIT_PORT=8025

# Colocar la URL real del entorno.
ASCLA_SITE_URL=http://localhost:8088
ASCLA_SITE_TITLE=ASCLA Comunidad profesional
ASCLA_ADMIN_USER=ascla.admin
ASCLA_ADMIN_EMAIL=admin@example.invalid

# local para desarrollo; usar el valor que defina el curso en QA/UAT.
ASCLA_WP_ENVIRONMENT_TYPE=local
ASCLA_LOCAL_MAIL_CAPTURE=true

# RNF-007: claves de servicio solo en el servidor. 0 es compatibilidad temporal;
# las pruebas quality-ci usan 0 únicamente para credenciales ficticias desechables.
ASCLA_EXTERNAL_SECRETS_ONLY=1
# Definir solo las variables de los servicios que se utilicen. No usar claves reales aquí.
# ASCLA_AI_KEY=
# ASCLA_OPENAI_KEY=
# ASCLA_DEEPSEEK_KEY=
# ASCLA_SUPADATA_KEY=
# ASCLA_GOOGLE_CLIENT_SECRET=
# ASCLA_TURNSTILE_SECRET=
# ASCLA_SMTP_PASSWORD=

# true solo cuando se quieran cargar los datos demo del comando `wp ascla seed`.
ASCLA_SEED_DATA=true
