meta {
  name: 10. Ana cancela su inscripción
  type: http
  seq: 10
}

post {
  url: {{base}}/wp-json/ascla/v1/events/{{eventoCupoId}}/register
  body: json
  auth: none
}

headers {
  Cookie: {{sesionAna}}
  X-WP-Nonce: {{nonceAna}}
  Content-Type: application/json
}

body:json {
  {
    "status": "cancelled"
  }
}

settings {
  followRedirects: false
  timeout: 30000
}

tests {
  test("Código HTTP esperado: 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Inscripción cancelada", function () { expect(res.getBody().registered).to.equal("cancelled"); });
}
