meta {
  name: 12. Desbloquear no restaura la conexión
  type: http
  seq: 12
}

get {
  url: {{base}}/wp-json/ascla/v1/profiles/{{idBruno}}
  body: none
  auth: none
}

headers {
  Cookie: {{sesionAna}}
  X-WP-Nonce: {{nonceAna}}
}

settings {
  followRedirects: false
  timeout: 30000
}

tests {
  test("Código HTTP esperado: 200", function () { expect(res.getStatus()).to.equal(200); });
  test("La relación termina sin permiso de mensajería", function () { expect(res.getBody().connection.state).to.equal("none");expect(res.getBody().connection.can_message).to.equal(false);expect(res.getBody().connection.blocked).to.equal(false); });
}
