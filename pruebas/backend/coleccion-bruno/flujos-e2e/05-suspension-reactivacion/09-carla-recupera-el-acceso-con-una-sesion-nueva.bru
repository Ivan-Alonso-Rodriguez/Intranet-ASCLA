meta {
  name: 09. Carla recupera el acceso con una sesión nueva
  type: http
  seq: 9
}

get {
  url: {{base}}/wp-json/ascla/v1/bootstrap
  body: none
  auth: none
}

headers {
  Cookie: {{sesionCarla}}
  X-WP-Nonce: {{nonceCarla}}
}

settings {
  followRedirects: false
  timeout: 30000
}

tests {
  test("Código HTTP esperado: 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Identidad y acceso recuperados", function () { expect(Number(res.getBody().me.id)).to.equal(Number(bru.getCollectionVar("idCarla"))); });
}
