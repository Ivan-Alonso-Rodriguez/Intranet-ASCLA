meta {
  name: 01. Iniciar sesión como Ana
  type: http
  seq: 1
}

post {
  url: {{base}}/wp-login.php
  body: formUrlEncoded
  auth: none
}

headers {
  Content-Type: application/x-www-form-urlencoded
  Cookie: wordpress_test_cookie=WP%20Cookie%20check
}

body:form-urlencoded {
  log: {{usuarioAna}}
  pwd: {{claveAna}}
  testcookie: 1
  redirect_to: {{base}}/intranet/
}

settings {
  followRedirects: false
  timeout: 30000
}

script:post-response {
  if (res.getStatus() === 302) {
    const cookies = res.getHeader("set-cookie") || [];
    const session = (Array.isArray(cookies) ? cookies : [cookies]).map(value => value.split(";")[0]).join("; ");
    bru.setVar("sesionAna", session);
    const page = await bru.sendRequest({method:"GET",url:bru.getCollectionVar("base")+"/intranet/",headers:{Cookie:session}});
    const match = String(page.data).match(/var ASCLA\s*=\s*(\{[\s\S]*?\});/);
    if (!match) throw Error("No se pudo obtener el nonce de Ana");
    bru.setVar("nonceAna", JSON.parse(match[1]).nonce);
  }
}

tests {
  test("Código HTTP esperado: 302", function () { expect(res.getStatus()).to.equal(302); });
  test("Sesión y nonce propios de Ana", function () { expect(bru.getVar("sesionAna")).to.be.a("string").and.not.empty;expect(bru.getVar("nonceAna")).to.be.a("string").and.not.empty; });
}
