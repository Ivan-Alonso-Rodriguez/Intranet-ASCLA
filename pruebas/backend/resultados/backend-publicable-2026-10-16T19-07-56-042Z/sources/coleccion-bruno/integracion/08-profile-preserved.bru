meta {
  name: 08. Comprobar que la empresa se conserva
  type: http
  seq: 8
}

get {
  url: {{base}}/wp-json/ascla/v1/profiles/{{idAsociado}}
  body: none
  auth: none
}

headers {
  Cookie: {{sesionAsociado}}
  X-WP-Nonce: {{nonceAsociado}}
}
settings {
  followRedirects: false
  timeout: 30000
}
tests {
  test("Perfil se vuelve a consultar", function () { expect(res.getStatus()).to.equal(200); });
  test("El rechazo conserva la empresa", function () { expect(res.getBody().company).to.equal(bru.getCollectionVar("empresaAnterior")); });
}
