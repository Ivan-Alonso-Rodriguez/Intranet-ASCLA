meta {
  name: 06. Ana abre la conversación
  type: http
  seq: 6
}

post {
  url: {{base}}/wp-json/ascla/v1/conversations
  body: json
  auth: none
}

headers {
  Cookie: {{sesionAna}}
  X-WP-Nonce: {{nonceAna}}
  Content-Type: application/json
}

body:json {
  {}
}

settings {
  followRedirects: false
  timeout: 30000
}

script:pre-request {
  req.setBody({target:Number(bru.getCollectionVar("idBruno"))});
}

script:post-response {
  if(res.getStatus()===200) bru.setCollectionVar("conversacionBloqueoId", Number(res.getBody().id));
}

tests {
  test("Código HTTP esperado: 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Conversación con ID real", function () { expect(Number(res.getBody().id)).to.be.above(0); });
}
