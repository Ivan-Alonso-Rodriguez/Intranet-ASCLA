meta {
  name: 16. Bruno confirma la vacante ofrecida
  type: http
  seq: 16
}

post {
  url: {{base}}/wp-json/ascla/v1/events/{{eventoCupoId}}/register
  body: json
  auth: none
}

headers {
  Cookie: {{sesionBruno}}
  X-WP-Nonce: {{nonceBruno}}
  Content-Type: application/json
}

body:json {
  {"status": "accepted"}
}

settings {
  followRedirects: false
  timeout: 30000
}

tests {
  test("Código HTTP esperado: 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Validación: 16. Bruno confirma la vacante ofrecida", function () { expect(res.getBody().registered).to.equal("accepted");expect(Number(res.getBody().attending)).to.equal(1); });
}
