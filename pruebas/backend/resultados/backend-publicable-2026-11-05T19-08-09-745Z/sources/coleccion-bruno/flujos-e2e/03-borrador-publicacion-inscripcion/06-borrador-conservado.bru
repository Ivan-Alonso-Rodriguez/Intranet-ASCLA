meta {
  name: 06. El rechazo conserva el borrador
  type: http
  seq: 6
}

get {
  url: {{base}}/wp-json/ascla/v1/items/{{eventoPublicacionId}}
  body: none
  auth: none
}

headers {
  Cookie: {{sesionAdministrador}}
  X-WP-Nonce: {{nonceAdministrador}}
}

settings {
  followRedirects: false
  timeout: 30000
}

tests {
  test("Código HTTP esperado: 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Validación: 06. El rechazo conserva el borrador", function () { expect(res.getBody().status).to.equal("draft");expect(res.getBody().title).to.equal(bru.getCollectionVar("tituloEventoPublicacion")); });
}
