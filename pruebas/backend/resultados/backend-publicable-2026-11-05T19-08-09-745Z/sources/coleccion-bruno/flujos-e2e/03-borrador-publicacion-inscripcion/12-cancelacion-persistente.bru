meta {
  name: 12. Comprobar el cierre del evento
  type: http
  seq: 12
}

get {
  url: {{base}}/wp-json/ascla/v1/events/{{eventoPublicacionId}}
  body: none
  auth: none
}

headers {
  Cookie: {{sesionAna}}
  X-WP-Nonce: {{nonceAna}}
}

settings {
  followRedirects: false
  timeout: 30000
}

tests {
  test("Código HTTP esperado: 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Validación: 12. Comprobar el cierre del evento", function () { expect(res.getBody().cancelled).to.equal(true); });
}
