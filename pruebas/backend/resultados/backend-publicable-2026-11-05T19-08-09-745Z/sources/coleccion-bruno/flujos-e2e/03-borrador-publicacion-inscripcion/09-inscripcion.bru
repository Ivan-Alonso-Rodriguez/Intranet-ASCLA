meta {
  name: 09. Ana confirma su inscripción
  type: http
  seq: 9
}

post {
  url: {{base}}/wp-json/ascla/v1/events/{{eventoPublicacionId}}/register
  body: json
  auth: none
}

headers {
  Cookie: {{sesionAna}}
  X-WP-Nonce: {{nonceAna}}
  Content-Type: application/json
}

body:json {
  {"status": "accepted"}
}

settings {
  followRedirects: false
  timeout: 30000
}

tests {
  test("Código HTTP esperado: 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Validación: 09. Ana confirma su inscripción", function () { expect(res.getBody().registered).to.equal("accepted"); });
}
