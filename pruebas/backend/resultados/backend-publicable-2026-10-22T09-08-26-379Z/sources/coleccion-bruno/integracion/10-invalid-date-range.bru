meta {
  name: 10. Rechazar fechas invertidas
  type: http
  seq: 10
}

get {
  url: {{base}}/wp-json/ascla/v1/content/event?after=2099-12-31&before=2020-01-01
  body: none
  auth: none
}

headers {
  Cookie: {{sesionAsociado}}
  X-WP-Nonce: {{nonceAsociado}}
}
settings {
  followRedirects: false
  timeout: 30000
}
tests {
  test("Rango de fechas invertido rechazado", function () { expect(res.getStatus()).to.equal(400); });
}
