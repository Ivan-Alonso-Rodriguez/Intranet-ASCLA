meta {
  name: 17. Rechazar conexión desde administración
  type: http
  seq: 17
}

post {
  url: {{base}}/wp-json/ascla/v1/relations
  body: json
  auth: none
}

headers {
  Cookie: {{sesionAdministrador}}
  X-WP-Nonce: {{nonceAdministrador}}
  Content-Type: application/json
}

body:json {
  {"target": {{idAna}}, "kind": "connect", "active": true}
}

settings {
  followRedirects: false
  timeout: 30000
}

tests {
  test("Código HTTP esperado: 403", function () { expect(res.getStatus()).to.equal(403); });

}
