meta {
  name: 09. Consultar directorio por páginas
  type: http
  seq: 9
}

get {
  url: {{base}}/wp-json/ascla/v1/profiles?page=1
  body: none
  auth: none
}

headers {
  Cookie: {{sesionAsociado}}
  X-WP-Nonce: {{nonceAsociado}}
}
settings {
  followRedirects: false
  timeout: 30000
}
tests {
  test("Directorio paginado", function () { expect(res.getStatus()).to.equal(200); });
  test("El directorio muestra doce perfiles por página y calcula las páginas", function () {
    const data = res.getBody();
    expect(data.items).to.be.an("array");
    expect(data.total).to.be.at.least(1);
    expect(data.per_page).to.equal(12);
    expect(data.page).to.equal(1);
    expect(data.pages).to.equal(Math.max(1, Math.ceil(data.total / data.per_page)));
    expect(data.items.length).to.equal(Math.min(data.total, data.per_page));
  });
}
