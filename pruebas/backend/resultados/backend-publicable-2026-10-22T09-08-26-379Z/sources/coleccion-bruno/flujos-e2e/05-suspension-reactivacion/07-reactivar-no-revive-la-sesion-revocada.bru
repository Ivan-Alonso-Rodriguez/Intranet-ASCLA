meta {
  name: 07. Reactivar no revive la sesión revocada
  type: http
  seq: 7
}

get {
  url: {{base}}/wp-json/ascla/v1/bootstrap
  body: none
  auth: none
}

headers {
  Cookie: {{sesionCarla}}
  X-WP-Nonce: {{nonceCarla}}
}

settings {
  followRedirects: false
  timeout: 30000
}

tests {
  test("Código HTTP esperado: 403", function () { expect(res.getStatus()).to.equal(403); });
  test("La sesión antigua sigue rechazada", function () { expect(res.getBody().code).to.equal("rest_cookie_invalid_nonce"); });
}
