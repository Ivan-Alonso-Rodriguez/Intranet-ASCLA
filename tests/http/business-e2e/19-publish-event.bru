meta {
  name: publish-event
  type: http
  seq: 19
}

post {
  url: {{base}}/wp-json/ascla/v1/content/event/{{eventId}}
  body: json
  auth: none
}

headers {
  Cookie: {{adminCookie}}
  X-WP-Nonce: {{adminNonce}}
  Content-Type: application/json
}
body:json {
  {
    "status": "publish"
  }
}
settings {
  followRedirects: false
  timeout: 30000
}
script:pre-request {
  const p=bru.getVar("eventDraft");req.setBody({title:p.title,body:p.body,status:"publish",meta:p.meta});
}
script:post-response {
  if(res.getStatus()===200) bru.setVar("publishedEvent",res.getBody());
}
tests {
  test("Administrador publica borrador", function () { expect(res.getStatus()).to.equal(200); });
  test("Estado publicado", function () { expect(res.getBody().status).to.equal("publish"); });
}
