meta {
  name: read-only-history
  type: http
  seq: 14
}

get {
  url: {{base}}/wp-json/ascla/v1/conversations/{{conversationId}}/messages
  body: none
  auth: none
}

headers {
  Cookie: {{bCookie}}
  X-WP-Nonce: {{bNonce}}
}
settings {
  followRedirects: false
  timeout: 30000
}
tests {
  test("Historial accesible despu\u00e9s de desconectar", function () { expect(res.getStatus()).to.equal(200); });
  test("El mensaje sigue intacto", function () { expect(res.getBody().items.some(m=>Number(m.id)===Number(bru.getVar("messageId")))).to.equal(true); });
}
