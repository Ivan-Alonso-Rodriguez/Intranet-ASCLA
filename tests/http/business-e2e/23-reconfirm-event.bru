meta {
  name: reconfirm-event
  type: http
  seq: 23
}

post {
  url: {{base}}/wp-json/ascla/v1/events/{{eventId}}/register
  body: json
  auth: none
}

headers {
  Cookie: {{aCookie}}
  X-WP-Nonce: {{aNonce}}
  Content-Type: application/json
}
body:json {
  {
    "status": "accepted"
  }
}
settings {
  followRedirects: false
  timeout: 30000
}
tests {
  test("Asociado reconfirma", function () { expect(res.getStatus()).to.equal(200); });
  test("Asistencia aceptada de nuevo", function () { expect(res.getBody().registered).to.equal("accepted"); });
}
