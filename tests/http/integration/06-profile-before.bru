meta {
  name: profile-before
  type: http
  seq: 6
}

get {
  url: {{base}}/wp-json/ascla/v1/profiles/{{aId}}
  body: none
  auth: none
}

headers {
  Cookie: {{aCookie}}
  X-WP-Nonce: {{aNonce}}
}
settings {
  followRedirects: false
  timeout: 30000
}
script:post-response {
  bru.setVar("previousCompany", res.getBody().company);
}
tests {
  test("Perfil disponible", function () { expect(res.getStatus()).to.equal(200); });
}
