meta {
  name: invalid-profile
  type: http
  seq: 7
}

post {
  url: {{base}}/wp-json/ascla/v1/profiles/me
  body: json
  auth: none
}

headers {
  Cookie: {{aCookie}}
  X-WP-Nonce: {{aNonce}}
  Content-Type: application/json
}
body:json {
  {
    "company": ""
  }
}
settings {
  followRedirects: false
  timeout: 30000
}
tests {
  test("El error identifica Empresa", function () { expect(res.getBody().message).to.include("Empresa"); });
  test("Empresa obligatoria se valida en servidor", function () { expect(res.getStatus()).to.equal(400); });
}
